ornoClasificado" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="951.3333333333334" y="600" width="420.66666666666663" height="48" /></mxCell><mxCell id="21" value="" style="rounded=0;fillColor=none;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="686" width="1080" height="560" /></mxCell><mxCell id="22" value="alt — entorno == null / clasificación disponible" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#152333;fontStyle=0;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="686" width="650" height="36" /></mxCell><mxCell id="23" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="943.3333333333334" y="780" /><mxPoint as="targetPoint" x="943.3333333333334" y="806" /><Array as="points"><mxPoint x="1018.3333333333334" y="780" /><mxPoint x="1018.3333333333334" y="806" /></Array></mxGeometry></mxCell><mxCell id="24" value="mantenerUltimaDecision()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="953.3333333333334" y="747" width="430" height="48" /></mxCell><mxCell id="25" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="765" y="856" /><mxPoint as="targetPoint" x="1845" y="856" /></mxGeometry></mxCell><mxCell id="26" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;stro