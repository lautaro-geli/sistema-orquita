<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="03_Secuencia_CU09" name="03_Secuencia_CU09"><mxGraphModel dx="1990" dy="1370" grid="0" page="1" pageScale="1" pageWidth="1990" pageHeight="1370" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="CU-09 — Actualizar estómago en el hilo escritor" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#152333;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1930" height="40" /></mxCell><mxCell id="3" value="El arranque ejecuta actualizador.start() una vez; la JVM invoca run(). Cada mensaje encola una captura y despierta ese hilo." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="66" width="1930" height="62" /></mxCell><mxCell id="4" value="Orquita" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="50.0" y="130" width="40" height="70" /></mxCell><mxCell id="5" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="70.0" y="240" /><mxPoint as="targetPoint" x="70.0" y="1305" /></mxGeometry></mxCell><mxCell id="6" value="Recopilador" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=1;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="287.5" y="150" width="250" height="62" /></mxCell><mxCell id="7" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geomet