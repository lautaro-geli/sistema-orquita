l(). Nuevas lecturas esperan mientras escriturasPendientes &gt; 0." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="825" y="517" width="560" height="80" /></mxCell><mxCell id="29" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1097.5" y="710" /><mxPoint as="targetPoint" x="1440.0" y="710" /></mxGeometry></mxCell><mxCell id="30" value="escribirRegistro(captura)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1105.5" y="680" width="326.5" height="48" /></mxCell><mxCell id="31" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1440.0" y="767" /><mxPoint as="targetPoint" x="1440.0" y="793" /><Array as="points"><mxPoint x="1515.0" y="767" /><mxPoint x="1515.0" y="793" /></Array></mxGeometry></mxCell><mxCell id="32" value="mutex.acquire()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1450.0" y="734" width="430" height="48" /></mxCell><mxCell id="33" value="[id nuevo] leerDelArchivo(), escribir el registro UTF-8 y cerrar el archivo." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="880" y="837" width="1020" height="45" /></mxCell><mxCell id="34" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;end