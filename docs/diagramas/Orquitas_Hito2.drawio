e=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#152333;fontStyle=0;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="263" width="600" height="36" /></mxCell><mxCell id="14" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="506.6666666666667" y="380" /><mxPoint as="targetPoint" x="943.3333333333334" y="380" /></mxGeometry></mxCell><mxCell id="15" value="determinarMovimiento(telemetria)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="514.6666666666667" y="350" width="420.6666666666667" height="48" /></mxCell><mxCell id="16" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="943.3333333333334" y="450" /><mxPoint as="targetPoint" x="1380.0" y="450" /></mxGeometry></mxCell><mxCell id="17" value="clasificarEntorno(telemetria)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="951.3333333333334" y="420" width="420.66666666666663" height="48" /></mxCell><mxCell id="18" value="synchronized: red.setInput(telemetria.normalizar()); red.calculate(); red.getOutput(). Salida mayor: LIBRE / OBJETO." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1280" y="486" width="590" height="100" /></mxCell><mxCell id="19" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1380.0" y="630" /><mxPoint as="targetPoint" x="943.3333333333334" y="630" /></mxGeometry></mxCell><mxCell id="20" value="entornoClasificado" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="951.3333333333334" y="600" width="420.66666666666663" height="48" /></mxCell><mxCell id="21" value="" style="rounded=0;fillColor=none;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="686" width="1080" height="560" /></mxCell><mxCell id="22" value="alt — entorno == null / clasificación disponible" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#152333;fontStyle=0;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="765" y="686" width="650" height="36" /></mxCell><mxCell id="23" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="943.3333333333334" y="780" /><mxPoint as="targetPoint" x="943.3333333333334" y="806" /><Array as="points"><mxPoint x="1018.3333333333334" y="780" /><mxPoint x="1018.3333333333334" y="806" /></Array></mxGeometry></mxCell><mxCell id="24" value="mantenerUltimaDecision()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="953.3333333333334" y="747" width="430" height="48" /></mxCell><mxCell id="25" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="765" y="856" /><mxPoint as="targetPoint" x="1845" y="856" /></mxGeometry></mxCell><mxCell id="26" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="943.3333333333334" y="940" /><mxPoint as="targetPoint" x="943.3333333333334" y="966" /><Array as="points"><mxPoint x="1018.3333333333334" y="940" /><mxPoint x="1018.3333333333334" y="966" /></Array></mxGeometry></mxCell><mxCell id="27" value="modoActual = obtenerModoOperativo()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="953.3333333333334" y="907" width="430" height="48" /></mxCell><mxCell id="28" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="943.3333333333334" y="1050" /><mxPoint as="targetPoint" x="943.3333333333334" y="1076" /><Array as="points"><mxPoint x="1018.3333333333334" y="1050" /><mxPoint x="1018.3333333333334" y="1076" /></Array></mxGeometry></mxCell><mxCell id="29" value="calcularMovimiento(entorno, modoActual, telemetria)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="953.3333333333334" y="1017" width="430" height="48" /></mxCell><mxCell id="30" value="LIBRE: AVANZAR. OBJETO: ambas sumas &lt; 1200 → DETENER; si izquierda &gt;= derecha → GIRAR_IZQ; en otro caso GIRAR_DER. Guardar ultimaDecision." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="805" y="1110" width="1000" height="90" /></mxCell><mxCell id="31" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="943.3333333333334" y="1320" /><mxPoint as="targetPoint" x="506.6666666666667" y="1320" /></mxGeometry></mxCell><mxCell id="32" value="Movimiento" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="514.6666666666667" y="1290" width="420.6666666666667" height="48" /></mxCell><mxCell id="33" value="Retorno por CU-06 al comunicador, que ejecuta CU-08. El modo ESCAPE se conserva; la búsqueda de salida física está pendiente." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="1372" width="1360" height="60" /></mxCell></root></mxGraphModel></diagram><diagram id="09_Secuencia_CU08" name="09_Secuencia_CU08"><mxGraphModel dx="1930" dy="1050" grid="0" page="1" pageScale="1" pageWidth="1930" pageHeight="1050" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="CU-08 — Enviar orden por la conexión de origen" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#152333;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1870" height="40" /></mxCell><mxCell id="3" value="Precondición: CU-06 recibió Movimiento desde CU-07. Writer representa el flujo de salida del socket de esa Orquita." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="66" width="1870" height="62" /></mx