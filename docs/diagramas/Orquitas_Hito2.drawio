try" relative="1"><mxPoint as="sourcePoint" x="785" y="581" /><mxPoint as="targetPoint" x="1398" y="581" /></mxGeometry></mxCell><mxCell id="21" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="943.3333333333334" y="653" /><mxPoint as="targetPoint" x="943.3333333333334" y="679" /><Array as="points"><mxPoint x="1018.3333333333334" y="653" /><mxPoint x="1018.3333333333334" y="679" /></Array></mxGeometry></mxCell><mxCell id="22" value="modoActual = cambiarModo(ESCAPE)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="953.3333333333334" y="620" width="430" height="48" /></mxCell><mxCell id="23" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="943.3333333333334" y="747" /><mxPoint as="targetPoint" x="1380.0" y="747" /></mxGeometry></mxCell><mxCell id="24" value="establecerModoOperativo(modoActual)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="951.3333333333334" y="717" width="420.66666666666663" height="48" /></mxCell><mxCell id="25" value="El modo queda en ESCAPE y no se revierte por un aviso tardío." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="804" y="795" width="565" height="58" /></mxCell><mxCell id="26" value="Contrato interno: EventoModoEscape(tipoEvento, cantidadCapturas, timestamp). Un tipo inválido produce IllegalArgumentException. Un aviso repetido en ESCAPE no cambia el estado." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="320" y="918" width="1062" height="67" /></mxCell></root></mxGraphModel></diagram><diagram id="08_Secuencia_CU07" name="08_Secuencia_CU07"><mxGraphModel dx="1930" dy="1480" grid="0" page="1" pageScale="1" pageWidth="1930" pageHeight="1480" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="CU-07 — Determinar movimiento con Neuroph" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#152333;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1870" height="40" /></mxCell><mxCell id="3" value="Actor asociado mediante ref CU-06. Se normalizan las distancias; la clasificación se obtiene por inferencia de una red entrenada." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="66" width="1870" height="62" /></mxCell><mxCell id="4" value="Orquita" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="50.0" y="130" width="40" height="70" /></mxCell><mxCell id="5" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="70.0" y="240" /><mxPoint as="targetPoint" x="70.0" y="1415" /></mxGeometry></mxCell><mxCell id="6" value="Recopilador" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=1;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent