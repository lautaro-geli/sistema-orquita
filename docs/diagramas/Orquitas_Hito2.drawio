nt" x="1097.5" y="710" /><mxPoint as="targetPoint" x="1440.0" y="710" /></mxGeometry></mxCell><mxCell id="30" value="escribirRegistro(captura)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1105.5" y="680" width="326.5" height="48" /></mxCell><mxCell id="31" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1440.0" y="767" /><mxPoint as="targetPoint" x="1440.0" y="793" /><Array as="points"><mxPoint x="1515.0" y="767" /><mxPoint x="1515.0" y="793" /></Array></mxGeometry></mxCell><mxCell id="32" value="mutex.acquire()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1450.0" y="734" width="430" height="48" /></mxCell><mxCell id="33" value="[id nuevo] leerDelArchivo(), escribir el registro UTF-8 y cerrar el archivo." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="880" y="837" width="1020" height="45" /></mxCell><mxCell id="34" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="863" y="888" /><mxPoint as="targetPoint" x="1913" y="888" /></mxGeometry></mxCell><mxCell id="35" value="[id duplicado] no agregar una segunda línea." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="880" y="893" width="1020" height="45" /></mxCell><mxCell id="36" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="863" y="945" /><mxPoint as="targetPoint" x="1913" y="945" /></mxGeometry></mxCell><mxCell id="37" value="[IOException] no confirmar la captura; propagar después del finally." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="880" y="950" width="1020" height="45" /></mxCell><mxCell id="38" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1440.0" y="1080" /><mxPoint as="targetPoint" x="1440.0" y="1106" /><Array as="points"><mxPoint x="1515.0" y="1080" /><mxPoint x="1515.0" y="1106" /></Array></mxGeometry></mxCell><mxCell id="39" value="finally: mutex.release()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1450.0" y="1047" width="430" height="48" /></mxCell><mxCell id="40" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1440.0" y="1124" /><mxPoint as="targetPoint" x="1097.5" y="1124" /></mxGeometry></mxCell><mxCell id="41" value="boolean / excepción" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1105.5" y="1094" width="326.5" height="48" /></mxCell><mxCell id="42" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;h