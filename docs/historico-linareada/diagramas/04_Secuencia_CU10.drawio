<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="04_Secuencia_CU10" name="04_Secuencia_CU10"><mxGraphModel dx="1990" dy="1590" grid="0" page="1" pageScale="1" pageWidth="1990" pageHeight="1590" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="CU-10 — Leer estómago con LOOP y CRITICAL" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#152333;fontStyle=1;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1930" height="40" /></mxCell><mxCell id="3" value="El auditor se inicia con lector.start() y continúa sin nuevos mensajes. Orquita es el actor asociado que origina las capturas; no invoca run()." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="66" width="1930" height="62" /></mxCell><mxCell id="4" value="Orquita" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=0;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="50.0" y="130" width="40" height="70" /></mxCell><mxCell id="5" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="70.0" y="240" /><mxPoint as="targetPoint" x="70.0" y="1525" /></mxGeometry></mxCell><mxCell id="6" value="ActualizadorEstomago" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=1;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="287.5" y="150" width="250" height="62" /></mxCell><mxCell id="7" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="412.5" y="240" /><mxPoint as="targetPoint" x="412.5" y="1525" /></mxGeometry></mxCell><mxCell id="8" value="ArchivoEstomago" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=1;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="630.0" y="150" width="250" height="62" /></mxCell><mxCell id="9" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="755.0" y="240" /><mxPoint as="targetPoint" x="755.0" y="1525" /></mxGeometry></mxCell><mxCell id="10" value="LectorEstomago" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=1;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="972.5" y="150" width="250" height="62" /></mxCell><mxCell id="11" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1097.5" y="240" /><mxPoint as="targetPoint" x="1097.5" y="1525" /></mxGeometry></mxCell><mxCell id="12" value="ActivadorModoEscape" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=1;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="1315.0" y="150" width="250" height="62" /></mxCell><mxCell id="13" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1440.0" y="240" /><mxPoint as="targetPoint" x="1440.0" y="1525" /></mxGeometry></mxCell><mxCell id="14" value="" style="rounded=0;fillColor=none;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="268" width="1900" height="1245" /></mxCell><mxCell id="15" value="par — escritor y lector independientes" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#152333;fontStyle=0;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="268" width="650" height="36" /></mxCell><mxCell id="16" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="32" y="475" /><mxPoint as="targetPoint" x="1932" y="475" /></mxGeometry></mxCell><mxCell id="17" value="" style="rounded=0;fillColor=none;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="46" y="328" width="625" height="58" /></mxCell><mxCell id="18" value="ref CU-06 y CU-09 — recepción y encolado de captura" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#152333;fontStyle=0;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="46" y="328" width="625" height="36" /></mxCell><mxCell id="19" value="CU-09 escribe con el mismo semáforo. Si una lectura ya comenzó, la escritura espera; ninguna lectura nueva adelanta una captura pendiente." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="355" y="390" width="1025" height="62" /></mxCell><mxCell id="20" value="" style="rounded=0;fillColor=none;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="501" width="1330" height="987" /></mxCell><mxCell id="21" value="loop — sistemaActivo() == true" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#152333;fontStyle=0;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="501" width="650" height="36" /></mxCell><mxCell id="22" value="" style="rounded=0;fillColor=none;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="599" y="562" width="805" height="460" /></mxCell><mxCell id="23" value="critical — lectura exclusiva del archivo" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#152333;fontStyle=0;spacing=6;fillColor=#edf2f7;strokeColor=#374151;" vertex="1" parent="1"><mxGeometry as="geometry" x="599" y="562" width="650" height="36" /></mxCell><mxCell id="24" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1097.5" y="638" /><mxPoint as="targetPoint" x="755.0" y="638" /></mxGeometry></mxCell><mxCell id="25" value="leerRegistros()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="763.0" y="608" width="326.5" height="48" /></mxCell><mxCell id="26" value="Admisión synchronized: wait() mientras hay escrituras pendientes. Luego mutex.acquire(). Si el archivo no existe, devolver lista vacía." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="679" width="737" height="80" /></mxCell><mxCell id="27" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="755.0" y="814" /><mxPoint as="targetPoint" x="755.0" y="840" /><Array as="points"><mxPoint x="830.0" y="814" /><mxPoint x="830.0" y="840" /></Array></mxGeometry></mxCell><mxCell id="28" value="leerDelArchivo()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="765.0" y="781" width="430" height="48" /></mxCell><mxCell id="29" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="755.0" y="885" /><mxPoint as="targetPoint" x="755.0" y="911" /><Array as="points"><mxPoint x="830.0" y="885" /><mxPoint x="830.0" y="911" /></Array></mxGeometry></mxCell><mxCell id="30" value="finally: mutex.release()" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="765.0" y="852" width="430" height="48" /></mxCell><mxCell id="31" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=1;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="755.0" y="970" /><mxPoint as="targetPoint" x="1097.5" y="970" /></mxGeometry></mxCell><mxCell id="32" value="registros válidos y únicos" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#152333;fontStyle=0;spacing=6;" vertex="1" parent="1"><mxGeometry as="geometry" x="763.0" y="940" width="326.5" height="48" /></mxCell><mxCell id="33" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;dashed=0;strokeColor=#374151;strokeWidth=1.5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1097